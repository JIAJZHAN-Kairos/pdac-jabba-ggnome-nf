manifest {
    name = 'JIAJZHAN-Kairos/pdac-jabba-ggnome-nf'
    version = '0.2.0'
    nextflowVersion = '>=24.10.0'
    description = 'Pinned JaBbA/gGnome analysis of original COBALT, ESVEE and PURPLE calls'
    mainScript = 'main.nf'
}
params {
    input = null
    outdir = null
    container = null
    expected_samples = null
    wave_id = null
    recovery = false
}
process {
    executor = 'awsbatch'
    container = params.container
    cpus = 4
    memory = '16 GB'
    time = '8h'
    maxForks = 20
    errorStrategy = 'terminate'
}
executor.queueSize = 20
aws.region = 'ap-southeast-2'
aws.batch.maxSpotAttempts = 3
profiles {
    aws { process.executor = 'awsbatch' }
    local { process.executor = 'local'; docker.enabled = true; docker.runOptions = '--platform linux/amd64 --entrypoint ""' }
}
process {
withName: FIRST_RUN {
    cpus = 4
    memory = '16 GB'
    time = '8h'
    maxForks = 20
}
withName: NATIVE_RECOVERY {
    cpus = 12
    memory = '64 GB'
    time = '48h'
    maxForks = 3
}
withName: HARD_RECOVERY {
    cpus = 24
    memory = '96 GB'
    time = '48h'
    maxForks = 2
}
withName: RECOVERY_REPORT {
    cpus = 1
    memory = '2 GB'
    time = '15m'
}
withName: RECOVERY_GATE {
    cpus = 1
    memory = '1 GB'
    time = '5m'
}
withName: REPORT_OUTCOMES {
    cpus = 1
    memory = '2 GB'
    time = '15m'
}
withName: EXECUTION_STATUS_GATE {
    cpus = 1
    memory = '1 GB'
    time = '5m'
}
}
